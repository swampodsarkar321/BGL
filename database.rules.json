{
  "rules": {
    "rooms": {
      "$room": {
        ".read": true,
        ".write": true,
        ".indexOn": [
          "createdAt",
          "status"
        ]
      }
    },
    "matchmaking": {
      "waiting": {
        ".read": true,
        ".write": true
      },
      "assign": {
        "$uid": {
          ".read": true,
          ".write": true
        }
      }
    },
    "live": {
      ".read": true,
      ".write": true,
      ".indexOn": [
        "ts"
      ]
    },
    "users": {
      "$user": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['name'])"
      }
    },
    "usernames": {
      "$name": {
        ".read": true,
        ".write": true
      }
    },
    "leaderboard": {
      ".read": true,
      "$user": {
        ".read": true,
        ".write": true
      }
    },
    "tournaments": {
      ".read": true,
      ".write": true
    },
    "anticheat": {
      ".read": "auth != null && auth.token.email == 'mdswampodsarkar@gmail.com'",
      ".write": true
    },
    "events": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'mdswampodsarkar@gmail.com'"
    },
    "store": {
      "items": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'mdswampodsarkar@gmail.com'"
      }
    }
  }
}